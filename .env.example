# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.

# Which backend answers: api | claude-cli | mock. Default (empty): api if
# ANTHROPIC_API_KEY is set, else claude-cli if the `claude` CLI is found, else mock.
AGENT_BACKEND=

# Anthropic API key (api backend). Server-side only.
ANTHROPIC_API_KEY=

# Claude CLI backend: uses your local Claude Code login. Model alias or full id
# (sonnet, haiku, opus, claude-sonnet-5-5, ...). haiku is ~0.3s faster to first token.
CLAUDE_CLI_MODEL=sonnet
# low | medium | high | xhigh | max
CLAUDE_CLI_EFFORT=low
# Absolute path to the claude executable if it isn't on the server's PATH.
CLAUDE_CLI_PATH=
# Kill the CLI if a turn takes longer than this.
CLAUDE_CLI_TIMEOUT_MS=60000

# API backend model. Default: claude-opus-5-5 (best vision + reasoning).
# Faster / cheaper options for snappier voice turns: claude-sonnet-5-5, claude-haiku-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# Reasoning effort: low | medium | high | xhigh | max. Low keeps voice latency down.
ANTHROPIC_EFFORT=low

# Max output tokens per reply (thinking + spoken text).
ANTHROPIC_MAX_TOKENS=4096

# Set to 1 to force the mock agent even when a key is present.
LIVE_HELP_MOCK=

# Set to 0 to disable server-side refusal fallbacks (fallbacks: "default").
LIVE_HELP_FALLBACKS=

# Camera frames sent with each user turn (1-3). Older frames are sampled every 1.5s.
NEXT_PUBLIC_FRAMES_PER_TURN=2
