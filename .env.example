# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.

# Anthropic API key. Leave empty to run the scripted mock agent (no key needed).
ANTHROPIC_API_KEY=

# Model used for the agent. Default: claude-opus-5-5 (best vision + reasoning).
# Faster / cheaper options for snappier voice turns: claude-sonnet-5-5, claude-haiku-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# Reasoning effort: low | medium | high | xhigh | max. Low keeps voice latency down.
ANTHROPIC_EFFORT=low

# Max output tokens per reply (thinking + spoken text).
ANTHROPIC_MAX_TOKENS=4096

# Set to 1 to force the mock agent even when a key is present.
LIVE_HELP_MOCK=

# Set to 0 to disable server-side refusal fallbacks (fallbacks: "default").
LIVE_HELP_FALLBACKS=

# Camera frames sent with each user turn (1-3). Older frames are sampled every 1.5s.
NEXT_PUBLIC_FRAMES_PER_TURN=2
